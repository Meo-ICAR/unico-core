{
    "name": "meo-icar/unico-core",
    "description": "Tabelle, modelli e risorse condivise della suite Unico per mediatori creditizi",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/console": "^13.0",
        "spatie/laravel-medialibrary": "^11.0",
        "filament/support": "^5.0",
        "webklex/laravel-imap": "^6.2",
        "laravel/socialite": "^5.0",
        "illuminate/mail": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/cache": "^13.0",
        "google/apiclient": "^2.18",
        "mikehaertl/php-pdftk": "^0.14.4"
    },
    "autoload": {
        "psr-4": {
            "Unico\\Core\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Unico\\Core\\UnicoCoreServiceProvider"
            ]
        },
        "google/apiclient-services": [
            "Drive"
        ]
    },
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Unico\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "pre-autoload-dump": "Google\\Task\\Composer::cleanup"
    }
}
